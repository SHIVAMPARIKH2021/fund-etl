pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Verify database and SEC endpoint connectivity without writes')
        booleanParam(name: 'FORCE', defaultValue: false, description: 'Force re-download and re-process even if previously ingested')
        string(name: 'TICKER', defaultValue: 'True', description: 'Fund ticker symbol flag or value')
        choice(name: 'FILING_YEAR', choices: ['2026', '2025', '2024', '2023'], description: 'Target filing year')
        choice(name: 'FILING_QUARTER', choices: ['1', '2', '3', '4'], description: 'Target filing quarter')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to run (e.g., latest or git-sha)')
    }

    environment {
        DOPPLER_TOKEN   = credentials('doppler-personal-token')
        DOPPLER_PROJECT = 'sec-pipeline'
        DOPPLER_CONFIG  = 'prd'
        SSH_CREDS_ID    = 'windows-laptop-ssh'
        IMAGE_BASE_NAME = 'fund-etl'
    }

    stages {
        stage('Fetch Secrets from Doppler Cloud') {
            steps {
                script {
                    def response = sh(
                        script: '''
                            curl -s --request GET \
                              --url "https://api.doppler.com/v3/configs/config/secrets/download?project=${DOPPLER_PROJECT}&config=${DOPPLER_CONFIG}&format=json" \
                              --header "accept: application/json" \
                              --header "authorization: Bearer ${DOPPLER_TOKEN}"
                        ''',
                        returnStdout: true
                    ).trim()

                    def secrets = readJSON text: response

                    env.WINDOWS_HOST    = secrets.WINDOWS_HOST
                    env.WINDOWS_USER    = secrets.WINDOWS_USER
                    env.SEC_USER_AGENT  = secrets.SEC_USER_AGENT
                    env.DB_USERNAME     = secrets.DB_USERNAME
                    env.DB_PASSWORD     = secrets.DB_PASSWORD
                    env.DB_HOST         = secrets.DB_HOST ?: 'host.docker.internal'
                    env.DB_PORT         = secrets.DB_PORT ?: '5432'
                    env.DB_NAME         = secrets.DB_NAME ?: 'funds'
                    env.DB_SCHEMA       = secrets.DB_SCHEMA ?: 'sec_financials'
                    env.RABBITMQ_HOST   = secrets.RABBITMQ_HOST ?: secrets.WINDOWS_HOST ?: 'host.docker.internal'
                    env.RABBITMQ_PORT   = secrets.RABBITMQ_PORT ?: '5672'
                }
            }
        }

        stage('Execute ETL Container') {
            steps {
                script {
                    def targetImage = "${IMAGE_BASE_NAME}:${params.IMAGE_TAG}"
                    def baseArgs = "--year ${params.FILING_YEAR} --quarter ${params.FILING_QUARTER} --ticker ${params.TICKER}"

                    if (params.FORCE) {
                        baseArgs = "${baseArgs} --force"
                    }

                    def runArgs = params.DRY_RUN ? "${baseArgs} --dry-run" : baseArgs

                    echo "Executing ${targetImage} with args: ${runArgs}"

                    withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                        sh """
                            set -e
                            ssh -i "\$SSH_KEY" \
                                -o StrictHostKeyChecking=no \
                                -o ConnectTimeout=15 \
                                ${WINDOWS_USER}@${WINDOWS_HOST} \
                                "docker run --rm \
                                    --add-host=host.docker.internal:host-gateway \
                                    -e DB_USERNAME='${DB_USERNAME}' \
                                    -e DB_PASSWORD='${DB_PASSWORD}' \
                                    -e DB_HOST='${DB_HOST}' \
                                    -e DB_PORT='${DB_PORT}' \
                                    -e DB_NAME='${DB_NAME}' \
                                    -e DB_SCHEMA='${DB_SCHEMA}' \
                                    -e SEC_USER_AGENT='${SEC_USER_AGENT}' \
                                    -e WINDOWS_HOST='${RABBITMQ_HOST}' \
                                    -e RABBITMQ_PORT='${RABBITMQ_PORT}' \
                                    ${targetImage} ${runArgs}"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "fund-etl run completed successfully for ${params.FILING_YEAR} Q${params.FILING_QUARTER} (Force=${params.FORCE})."
        }
        failure {
            echo "fund-etl run failed. Review logs above."
        }
    }
}